# VITE_SCANNER_API_URL: The public URL of the deployed Netlify function (or local endpoint) for scanning.
# Ensure this points to the function endpoint. It is safe to expose this to the client.
VITE_SCANNER_API_URL="http://localhost:8888/.netlify/functions/scan"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# MUST BE KEPT SECRET! Only configure this on the server (e.g., Netlify Environment Variables).
# Never expose this in client-side code or prefix with VITE_!
GEMINI_API_KEY="MY_GEMINI_API_KEY"

